r:var(--gold)}h1,h2,h3{font-family:Georgia,'Times New Roman',serif;line-height:1.15}h1{font-size:clamp(3.2rem,6.3vw,5.8rem);max-width:760px;margin:16px 0 22px;font-weight:500}h1 em{color:#f4cb87;font-style:italic}.hero p{font-size:1.14rem;max-width:570px;color:#e7eef1}.actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:30px}.trust-strip{background:#fff;border-bottom:1px solid #e6e9e8}.trust{display:grid;grid-template-columns:repeat(3,1fr);gap:22px;padding:25px 0}.trust div{display:flex;gap:12px;align-items:center;font-size:.9rem;font-weight:700}.trust span{font-size:1.5rem;color:var(--teal)}section{padding:90px 0}.section-head{text-align:center;max-width:720px;margin:0 auto 42px}.section-head .eyebrow{color:var(--teal)}h2{font-size:clamp(2.25rem,4vw,3.35rem);font-weight:500;margin:12px 0 15px;color:var(--navy)}.section-head p,.muted{color:var(--muted)}.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:23px}.card{background:#fff;border-radius:10px;overflow:hidden;box-shadow:0 10px 35px #10283b0d}.card img{width:100%;height:255px;object-fit:cover;display:block}.card-body{padding:25px}.card h3{font-size:1.5rem;margin:0 0 8px}.card p{color:var(--muted);font-size:.94rem;margin:0 0 14px}.text-link{color:var(--teal);font-weight:800;font-size:.91rem}.about{background:#eaf2f0}.about-grid{display:grid;grid-template-columns:1fr 1fr;gap:70px;align-items:center}.about-photo{width:100%;height:470px;object-fit:cover;border-radius:10px}.about h2{margin-top:12px}.about p{color:#536774}.ticks{padding:0;list-style:none}.ticks li{margin:11px 0}.ticks li:before{content:'✓';color:var(--teal);font-weight:900;margin-right:12px}.form-section{background:var(--navy);color:white}.form-section h2{color:white}.form-grid{display:grid;grid-template-columns:.82fr 1.18fr;gap:65px;align-items:start}.form-intro p{color:#cbd8df}.contact-info{margin-top:35px;color:#e6f1f1}.form-card{background:white;border-radius:12px;padding:34px;color:var(--ink);box-shadow:0 18px 50px #0002}.form-card h3{margin:0 0 6px;font-size:1.8rem}.form-card>p{color:var(--muted);margin-top:0;font-size:.9rem}.fields{display:grid;grid-template-columns:1fr 1fr;gap:17px}.field{display:flex;flex-direction:column;gap:5px}.full{grid-column:1/-1}label{font-size:.82rem;font-weight:750}input,select,textarea{width:100%;padding:12px;border:1px solid #ccd6da;border-radius:5px;background:#fff;color:var(--ink)}textarea{min-height:105px;resize:vertical}input:focus,select:focus,textarea:focus{outline:2px solid #6ebcc0;outline-offset:1px}.fine{font-size:.78rem;color:var(--muted);line-height:1.5}.form-card .btn{width:100%;margin-top:8px}.faq{max-width:780px;margin:auto}.faq details{border-bottom:1px solid #dbe1e1;padding:18px 0}.faq summary{cursor:pointer;font-weight:750}.faq p{color:var(--muted)}footer{background:#071b29;color:#d5e1e6;padding:52px 0 22px}.footer-grid{display:grid;grid-template-columns:2fr 1fr 1fr;gap:45px}.footer-grid h3{color:white;margin:0 0 15px}.footer-grid p{max-width:420px;color:#aec1cc}.footer-grid a{display:block;margin:8px 0}.footer-bottom{border-top:1px solid #ffffff24;margin-top:38px;padding-top:18px;font-size:.78rem;color:#a5b7c0}.skip{position:absolute;left:-9999px}.skip:focus{left:10px;top:10px;z-index:20;background:white;padding:10px}@media(max-width:850px){.links{display:none;position:absolute;top:82px;left:0;right:0;background:white;flex-direction:column;padding:20px;box-shadow:0 15px 20px #0002}.links.open{display:flex}.menu{display:block}.cards,.trust{grid-template-columns:1fr}.cards{max-width:520px;margin:auto}.about-grid,.form-grid{grid-template-columns:1fr;gap:35px}.about-photo{height:320px}.hero{min-height:570px}.hero-inner{padding:75px 0}.footer-grid{grid-template-columns:1fr 1fr}.footer-grid>div:first-child{grid-column:1/-1}}@media(max-width:540px){section{padding:65px 0}.fields{grid-template-columns:1fr}.form-card{padding:23px}.footer-grid{grid-template-columns:1fr}.footer-grid>div:first-child{grid-column:auto}.brand strong{font-size:1.04rem}.brand small{font-size:.55rem}.hero{background-position:62% center}.trust{gap:10px}.container{width:min(100% - 28px,1150px)}}
</style></head><body><a class="skip" href="#main">Skip to main content</a><div class="topbar">Thoughtful travel planning • Memorable experiences • Personal attention</div><header class="header"><nav class="nav container" aria-label="Main navigation"><a class="brand" href="#home" aria-label="HUTA home"><span class="mark" aria-hidden="true">✦</span><span><strong>Horvat Universal</strong><small>TRAVEL AGENCY · HUTA</small></span></a><button class="menu" id="menu" aria-label="Toggle navigation" aria-expanded="false">☰</button><div class="links" id="links"><a href="#experiences">Travel Experiences</a><a href="#about">About Us</a><a href="#faq">FAQs</a><a href="#contact" class="btn primary">Plan My Trip</a></div></nav></header><main id="main"><div id="home" class="hero"><div class="container hero-inner"><div class="eyebrow">Welcome to Horvat Universal Travel Agency</div><h1>Go somewhere <em>extraordinary.</em></h1><p>From family adventures and ocean cruises to once-in-a-lifetime escapes, let us help turn your travel ideas into a journey worth remembering.</p><div class="actions"><a class="btn primary" href="#contact">Plan My Trip →</a><a class="btn outline" href="#experiences">Explore Our Services</a></div></div></div><div class="trust-strip"><div class="container trust"><div><span>◇</span> Travel plans tailored to you</div><div><span>☼</span> Family-friendly vacation ideas</div><div><span>✧</span> A personal planning experience</div></div></div><section id="experiences"><div class="container"><div class="section-head"><div class="eyebrow">Discover your next getaway</div><h2>Travel experiences made for you</h2><p>Whether you know exactly where you want to go or need inspiration, start with the kind of trip that excites you.</p></div><div class="cards"><article class="card"><img loading="lazy" alt="Cruise ship at sea" src="https://images.unsplash.com/photo-1548574505-5e239809ee19?auto=format&fit=crop&w=900&q=80"><div class="card-body"><h3>Ocean Cruises</h3><p>Explore cruise options, itineraries, ports, and experiences that fit your travel style.</p><a class="text-link" href="#contact">Ask about cruises →</a></div></article><article class="card"><img loading="lazy" alt="Family enjoying a sunny beach" src="https://images.unsplash.com/photo-1506126613408-eca07ce68773?auto=format&fit=crop&w=900&q=80"><div class="card-body"><h3>Family Vacations</h3><p>Make more memories together with family-focused destinations and activity planning.</p><a class="text-link" href="#contact">Plan a family trip →</a></div></article><article class="card"><img loading="lazy" alt="Tropical resort on a beautiful coastline" src="https://images.unsplash.com/photo-1514282401047-d79a71a590e8?auto=format&fit=crop&w=900&q=80"><div class="card-body"><h3>Custom Getaways</h3><p>Relaxing resorts, romantic escapes, group adventures, and personalized itineraries.</p><a class="text-link" href="#contact">Design my getaway →</a></div></article></div></div></section><section class="about" id="about"><div class="container about-grid"><img class="about-photo" loading="lazy" alt="Scenic mountain lake destination" src="https://images.unsplash.com/photo-1470770841072-f978cf4d019e?auto=format&fit=crop&w=1000&q=85"><div><div class="eyebrow" style="color:var(--teal)">A more personal way to travel</div><h2>Big adventures begin with a conversation.</h2><p>At Horvat Universal Travel Agency, our goal is simple: help travelers feel excited and informed as they plan their next experience.</p><p>We start by learning about your priorities, travel dates, interests, and budget. From there, we can discuss options and the next steps for planning your trip.</p><ul class="ticks"><li>Planning around your goals and budget</li><li>Ideas for couples, families, and groups</li><li>Clear communication along the way</li></ul><a class="btn primary" href="#contact">Let's Plan Your Trip</a></div></div></section><section id="contact" class="form-section"><div class="container form-grid"><div class="form-intro"><div class="eyebrow">Let's get started</div><h2>Your next adventure starts here.</h2><p>Tell us a little about the trip you have in mind. We’ll use your details to begin a personalized conversation about travel options.</p><p>Not sure where you want to go? That's okay — inspiration is part of the journey.</p><div class="contact-info"><strong>Questions?</strong><p>Email: <a href="mailto:info@elyitex.com">info@elyitex.com</a></p></div></div><form class="form-card" id="tripForm"><h3>Plan My Trip</h3><p>Complete the form below to prepare an email inquiry.</p><div class="fields"><div class="field"><label for="name">Full name *</label><input id="name" name="name" autocomplete="name" required maxlength="100"></div><div class="field"><label for="email">Email address *</label><input id="email" name="email" type="email" autocomplete="email" required maxlength="150"></div><div class="field"><label for="trip">Type of trip *</label><select id="trip" name="trip" required><option value="">Choose an experience</option><option>Cruise</option><option>Family vacation</option><option>Theme park vacation</option><option>Resort getaway</option><option>Group travel</option><option>Not sure yet</option><option>Other</option></select></div><div class="field"><label for="destination">Destination or region</label><input id="destination" name="destination" placeholder="Anywhere in mind?" maxlength="150"></div><div class="field"><label for="depart">Preferred departure date</label><input id="depart" name="depart" type="date"></div><div class="field"><label for="flex">Date flexibility</label><select id="flex" name="flex"><option>Flexible</option><option>Exact dates</option><option>Within a few weeks</option></select></div><div class="field"><label for="adults">Adults *</label><input id="adults" name="adults" type="number" min="1" max="50" value="2" required></div><div class="field"><label for="children">Children</label><input id="children" name="children" type="number" min="0" max="50" value="0"></div><div class="field full"><label for="budget">Approximate total trip budget (USD, excluding flights if preferred)</label><select id="budget" name="budget"><option value="">Not sure yet</option><option>Under $2,000</option><option>$2,000–$4,999</option><option>$5,000–$9,999</option><option>$10,000+</option><option>Flexible</option></select></div><div class="field full"><label for="notes">Tell us about your dream trip</label><textarea id="notes" name="notes" maxlength="1500" placeholder="Occasion, interests, preferred experiences, or anything we should know..."></textarea></div><div class="full"><p class="fine">By continuing, your email application will open with these details filled in. <strong>Your inquiry is not sent until you send that email yourself.</strong> Please don't include payment card numbers, passport details, or sensitive personal information.</p><button class="btn primary" type="submit">Prepare My Travel Inquiry →</button><p class="fine" id="status" role="status" aria-live="polite"></p></div></div></form></div></section><section id="faq"><div class="container"><div class="section-head"><div class="eyebrow">Good to know</div><h2>Frequently asked questions</h2></div><div class="faq"><details><summary>Can I inquire even if I don't know where to travel?</summary><p>Absolutely. Tell us about your interests, ideal travel dates, and approximate budget, and we can start discussing ideas.</p></details><details><summary>Do you only help with cruises?</summary><p>No. You can inquire about cruises, family vacations, theme park trips, resorts, group travel, and custom getaways.</p></details><details><summary>Are planning fees included?</summary><p>Any applicable planning fees, service scope, and booking terms should be disclosed and agreed upon before paid services begin. Request details when you contact us.</p></details><details><summary>Does this website book trips instantly?</summary><p>Not yet. The Plan My Trip form prepares an inquiry email. It is not a live booking engine and does not confirm availability or reservations.</p></details></div></div></section></main><footer><div class="container"><div class="footer-grid"><div><h3>Horvat Universal Travel Agency</h3><p>Explore more. Experience more. Make memories that stay with you.</p><p>Online at ElyiteX.com</p></div><div><h3>Explore</h3><a href="#experiences">Travel Experiences</a><a href="#about">About Us</a><a href="#faq">FAQs</a></div><div><h3>Get in touch</h3><a href="#contact">Plan My Trip</a><a href="mailto:info@elyitex.com">info@elyitex.com</a></div></div><div class="footer-bottom">© <span id="year"></span> Horvat Universal Travel Agency. All rights reserved. Travel arrangements and prices are subject to confirmation. No reservation is created by submitting an inquiry. Travel photography is illustrative.</div></div></footer><script>document.getElementById('year').textContent=new Date().getFullYear();const menu=document.getElementById('menu'),links=document.getElementById('links');menu.addEventListener('click',()=>{const open=links.classList.toggle('open');menu.setAttribute('aria-expanded',String(open))});links.querySelectorAll('a').forEach(a=>a.addEventListener('click',()=>{links.classList.remove('open');menu.setAttribute('aria-expanded','false')}));document.getElementById('tripForm').addEventListener('submit',function(e){e.preventDefault();if(!this.reportValidity())return;const d=new FormData(this);const lines=['New HUTA Travel Inquiry','',...Array.from(d.entries()).map(([k,v])=>k.replace(/(^|\s)\S/g,c=>c.toUpperCase())+': '+(v||'Not specified')),'','Please reply with next steps and any applicable planning fees.'];const subject='HUTA Travel Inquiry — '+String(d.get('name')).slice(0,70);const mail='mailto:info@elyitex.com?subject='+encodeURIComponent(subject)+'&body='+encodeURIComponent(lines.join('\n'));document.getElementById('status').textContent='Your email app should open. Please review and send the email to complete your inquiry. If it does not open, email info@elyitex.com directly.';window.location.href=mail});</script></body></html>
